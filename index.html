eight: 78%; } }\n  @keyframes steamRise { 0% { opacity:0; transform:translateY(0) scaleY(0.8); } 40% { opacity:0.8; } 100% { opacity:0; transform:translateY(-16px) scaleY(1.1); } }\n  ::selection { background: #e8b796; color: #3b241a; }\n  a { color: #b5502f; text-decoration: none; }\n  a:hover { color: #8c3b21; }\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"min-height:100vh; background: #fbf3ea; font-family: 'Karla', sans-serif; color: #3b241a; display:flex; flex-direction:column; position:relative; overflow:hidden;\">\n\n  <div style=\"{{ loaderStyle }}\">\n    <div style=\"position:relative; width:64px; height:56px;\">\n      <div style=\"position:absolute; bottom:44px; left:14px; width:6px; height:12px; border:2.5px solid #b5502f; border-bottom:none; border-radius:6px 6px 0 0; opacity:0.75; animation:steamRise 1.8s ease-in-out infinite;\"><\u002Fdiv>\n      <div style=\"position:absolute; bottom:44px; left:29px; width:6px; height:14px; border:2.5px solid #b5502f; border-bottom:none; border-radius:6px 6px 0 0; opacity:0.75; animation:steamRise 1.8s ease-in-out infinite 0.4s;\"><\u002Fdiv>\n      <div style=\"position:absolute; bottom:44px; left:44px; width:6px; height:12px; border:2.5px solid #b5502f; border-bottom:none; border-radius:6px 6px 0 0; opacity:0.75; animation:steamRise 1.8s ease-in-out infinite 0.8s;\"><\u002Fdiv>\n      <div style=\"position:absolute; right:-16px; top:12px; width:18px; height:22px; border:3px solid #6b4226; border-left:none; border-radius:0 12px 12px 0;\"><\u002Fdiv>\n      <div style=\"position:absolute; bottom:0; left:0; width:64px; height:44px; border:3px solid #6b4226; border-top:none; border-radius:0 0 16px 16px; overflow:hidden; background:#fff8ee;\">\n        <div style=\"position:absolute; bottom:0; left:0; right:0; background:#8a5a2b; animation:cupFill 1.5s ease-in-out forwards;\"><\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <div style=\"font-family:'Lora',serif; font-size:14px; color:#8c5a2b; letter-spacing:0.05em; margin-top:14px;\">brewing…<\u002Fdiv>\n  <\u002Fdiv>\n\n  <header style=\"position:sticky; top:0; z-index:50; background:rgba(251,243,234,0.92); backdrop-filter:blur(8px); border-bottom:1px solid #e8d9c8; display:flex; align-items:center; justify-content:space-between; padding:18px 48px;\">\n    <div sc-camel-on-click=\"{{ goHome }}\" style=\"font-family:'Lora',serif; font-weight:700; font-size:22px; cursor:pointer; letter-spacing:-0.01em;\">Aryan Kochhar<\u002Fdiv>\n    <div style=\"display:flex; align-items:center; gap:18px;\">\n      <nav style=\"display:flex; gap:8px;\">\n        <sc-for list=\"{{ navItems }}\" as=\"item\" hint-placeholder-count=\"4\">\n          <div sc-camel-on-click=\"{{ item.go }}\" style=\"{{ item.style }}\">{{ item.label }}<\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fnav>\n      {{ coffeeButtonNode }}\n    <\u002Fdiv>\n  <\u002Fheader>\n  {{ quoteBubbleNode }}\n\n  <main style=\"flex:1; width:100%;\">\n\n    <sc-if value=\"{{ isHome }}\" hint-placeholder-val=\"{{ true }}\">\n      <section style=\"max-width:1080px; margin:0 auto; padding:100px 48px 60px; display:flex; gap:56px; align-items:center; flex-wrap:wrap;\">\n        <div style=\"flex:1; min-width:320px; animation: floatUp 0.6s ease both;\">\n          <div style=\"display:flex; gap:10px; flex-wrap:wrap; margin-bottom:22px;\">\n            <div style=\"display:inline-flex; align-items:center; gap:8px; background:#f3e2ce; color:#8c5a2b; padding:6px 14px; border-radius:999px; font-size:13px; font-weight:600; letter-spacing:0.02em;\">\n              <div style=\"position:relative; width:22px; height:18px; flex-shrink:0;\">\n                <div style=\"position:absolute; bottom:14px; left:4px; width:3px; height:6px; border:1.5px solid #8c5a2b; border-bottom:none; border-radius:3px 3px 0 0; opacity:0.7; animation:steamRise 1.8s ease-in-out infinite;\"><\u002Fdiv>\n                <div style=\"position:absolute; bottom:14px; left:10px; width:3px; height:7px; border:1.5px solid #8c5a2b; border-bottom:none; border-radius:3px 3px 0 0; opacity:0.7; animation:steamRise 1.8s ease-in-out infinite 0.4s;\"><\u002Fdiv>\n                <div style=\"position:absolute; bottom:14px; left:16px; width:3px; height:6px; border:1.5px solid #8c5a2b; border-bottom:none; border-radius:3px 3px 0 0; opacity:0.7; animation:steamRise 1.8s ease-in-out infinite 0.8s;\"><\u002Fdiv>\n                <div style=\"position:absolute; right:-6px; top:4px; width:7px; height:8px; border:1.5px solid #8c5a2b; border-left:none; border-radius:0 5px 5px 0;\"><\u002Fdiv>\n                <div style=\"position:absolute; bottom:0; left:0; width:22px; height:14px; border:1.5px solid #8c5a2b; border-top:none; border-radius:0 0 7px 7px; background:#fff8ee;\"><\u002Fdiv>\n              <\u002Fdiv>\n              Chennai, India\n            <\u002Fdiv>\n            <div style=\"display:inline-flex; align-items:center; gap:8px; background:#eaf3e6; color:#4d7a3d; padding:6px 14px; border-radius:999px; font-size:13px; font-weight:600; letter-spacing:0.02em;\"><span style=\"width:7px; height:7px; border-radius:50%; background:#4d7a3d; display:inline-block;\"><\u002Fspan>Open to opportunities<\u002Fdiv>\n          <\u002Fdiv>\n          <h1 style=\"font-family:'Lora',serif; font-size:52px; line-height:1.1; margin:0 0 20px; font-weight:700; letter-spacing:-0.01em;\">Hi, I'm <span style=\"color:#b5502f;\">Arry<\u002Fspan>.<\u002Fh1>\n          <div style=\"width:56px; height:4px; background:#e0a97a; border-radius:2px; margin:-8px 0 24px;\"><\u002Fdiv>\n          <p style=\"font-size:19px; line-height:1.6; color:#5c4432; max-width:520px; margin:0 0 32px;\">I build AI agents and RAG pipelines for a living, and I'm pretty relaxed about most everything else — except my coffee order, which comes non-negotiable.<\u002Fp>\n          <div style=\"display:flex; gap:14px; flex-wrap:wrap;\">\n            <button sc-camel-on-click=\"{{ goWork }}\" style=\"background:#b5502f; color:#fff; border:none; padding:14px 26px; border-radius:10px; font-family:'Karla',sans-serif; font-weight:700; font-size:15px; cursor:pointer;\" style-hover=\"background:#8c3b21;\">See my work<\u002Fbutton>\n            <button sc-camel-on-click=\"{{ goContact }}\" style=\"background:transparent; color:#3b241a; border:1.5px solid #d9c3a9; padding:14px 26px; border-radius:10px; font-family:'Karla',sans-serif; font-weight:700; font-size:15px; cursor:pointer;\" style-hover=\"background:#f3e2ce;\">Say hi<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"width:280px; height:280px; flex-shrink:0;\">\n          <image-slot id=\"profile-photo\" shape=\"circle\" src=\"d5125922-bc00-4b1b-86da-a9dbd0860644\" placeholder=\"drop a photo of yourself\" style=\"width:280px; height:280px; border-radius:50%; box-shadow:0 20px 50px -20px rgba(59,36,26,0.4);\"><\u002Fimage-slot>\n        <\u002Fdiv>\n      <\u002Fsection>\n\n      <section style=\"max-width:1080px; margin:0 auto; padding:20px 48px 80px; display:grid; grid-template-columns:repeat(3,1fr); gap:20px;\">\n        <sc-for list=\"{{ focusAreas }}\" as=\"area\" hint-placeholder-count=\"0\">\n          <div style=\"background:#fff; border:1px solid #eee0cf; border-top:3px solid #b5502f; border-radius:16px; padding:22px 22px 24px; position:relative;\">\n            <div style=\"font-family:'Lora',serif; font-size:13px; font-weight:700; color:#e0a97a; margin-bottom:10px;\">{{ area.mark }}<\u002Fdiv>\n            <div style=\"font-family:'Lora',serif; font-size:18px; font-weight:600; color:#3b241a;\">{{ area.title }}<\u002Fdiv>\n            <div style=\"font-size:14px; color:#6b5645; margin-top:8px; line-height:1.5;\">{{ area.blurb }}<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fsection>\n\n      <section style=\"background:#f3e6d4; padding:70px 48px;\">\n        <div style=\"max-width:1080px; margin:0 auto;\">\n          <div style=\"font-size:12.5px; font-weight:700; letter-spacing:0.08em; color:#b5502f; text-transform:uppercase; margin-bottom:8px;\">☕ Fresh off the brew<\u002Fdiv>\n          <h2 style=\"font-family:'Lora',serif; font-size:28px; margin:0 0 8px;\">A few recent builds<\u002Fh2>\n          <p style=\"color:#6b5645; margin:0 0 32px;\">Agentic systems, RAG pipelines, and other rabbit holes.<\u002Fp>\n          <div style=\"display:grid; grid-template-columns:repeat(3,1fr); gap:20px;\">\n            <sc-for list=\"{{ featuredProjects }}\" as=\"proj\" hint-placeholder-count=\"0\">\n              <div style=\"background:#fff; border-radius:16px; overflow:hidden; border:1px solid #eee0cf; cursor:pointer;\" style-hover=\"box-shadow:0 16px 32px -20px rgba(59,36,26,0.3); transform:translateY(-2px);\" sc-camel-on-click=\"{{ proj.onCardClick }}\">\n                <div style=\"width:100%; aspect-ratio:16/10; background:#f3e6d4; position:relative; overflow:hidden;\">\n                  <sc-if value=\"{{ proj.hasDemo }}\" hint-placeholder-val=\"{{ false }}\">\n                    <div style=\"width:100%; height:100%; transition:background-image 0.5s ease; {{ proj.thumbStyle }}\"><\u002Fdiv>\n                  <\u002Fsc-if>\n                  <sc-if value=\"{{ proj.noDemo }}\" hint-placeholder-val=\"{{ false }}\">\n                    <image-slot id=\"{{ proj.slotId }}\" shape=\"rect\" placeholder=\"drop a screenshot\" style=\"width:100%; height:100%;\"><\u002Fimage-slot>\n                  <\u002Fsc-if>\n                <\u002Fdiv>\n                <div style=\"padding:22px;\">\n                  <div style=\"font-family:'Lora',serif; font-weight:600; font-size:18px; color:#3b241a; margin-bottom:8px;\">{{ proj.name }}<\u002Fdiv>\n                  <div style=\"font-size:14px; color:#6b5645; line-height:1.5;\">{{ proj.short }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n          <div style=\"margin-top:28px;\">\n            <span sc-camel-on-click=\"{{ goWork }}\" style=\"cursor:pointer; font-weight:700; color:#b5502f;\">See all projects →<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsection>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isAbout }}\" hint-placeholder-val=\"{{ false }}\">\n      <section style=\"max-width:820px; margin:0 auto; padding:80px 48px;\">\n        <div style=\"font-size:12.5px; font-weight:700; letter-spacing:0.08em; color:#b5502f; text-transform:uppercase; margin-bottom:10px;\">The person behind the code<\u002Fdiv>\n        <h1 style=\"font-family:'Lora',serif; font-size:40px; margin:0 0 28px;\">A bit about <span style=\"color:#b5502f;\">me<\u002Fspan><\u002Fh1>\n        <div style=\"display:flex; gap:32px; flex-wrap:wrap; margin-bottom:8px;\">\n          <div style=\"flex:1; min-width:280px;\">\n            <p style=\"font-size:18px; line-height:1.75; color:#4a3527; margin:0 0 20px;\">I'm a final-year AI/ML student at Vellore Institute of Technology (CGPA 9.27, if that matters to you), building agentic systems and RAG pipelines that chain tools together to actually get things done — not just answer questions.<\u002Fp>\n            <p style=\"font-size:18px; line-height:1.75; color:#4a3527; margin:0 0 20px;\">Last summer I interned at WE Excel Software, where I built an OCR pipeline for HR document processing and tuned retrieval for a RAG-based HR chatbot. Outside of internships, I'm usually deep in a side project — teaching an agent to backtest trading strategies, or turning a text prompt into a whole 3D city.<\u002Fp>\n          <\u002Fdiv>\n          <div style=\"width:260px; height:300px; flex-shrink:0;\">\n            <image-slot id=\"about-photo\" shape=\"rounded\" radius=\"18\" src=\"7d98b504-cbdc-4ebe-b1f7-d1177b014c31\" placeholder=\"drop another photo of yourself\" style=\"width:260px; height:300px; box-shadow:0 16px 36px -18px rgba(59,36,26,0.4);\"><\u002Fimage-slot>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:flex; align-items:center; gap:16px; background:#f3e6d4; border-radius:16px; padding:18px 22px; margin:0 0 40px;\">\n          <div style=\"position:relative; width:26px; height:21px; flex-shrink:0;\">\n            <div style=\"position:absolute; bottom:16px; left:5px; width:3px; height:7px; border:1.5px solid #8c5a2b; border-bottom:none; border-radius:3px 3px 0 0; opacity:0.7; animation:steamRise 1.8s ease-in-out infinite;\"><\u002Fdiv>\n            <div style=\"position:absolute; bottom:16px; left:12px; width:3px; height:8px; border:1.5px solid #8c5a2b; border-bottom:none; border-radius:3px 3px 0 0; opacity:0.7; animation:steamRise 1.8s ease-in-out infinite 0.4s;\"><\u002Fdiv>\n            <div style=\"position:absolute; bottom:16px; left:19px; width:3px; height:7px; border:1.5px solid #8c5a2b; border-bottom:none; border-radius:3px 3px 0 0; opacity:0.7; animation:steamRise 1.8s ease-in-out infinite 0.8s;\"><\u002Fdiv>\n            <div style=\"position:absolute; right:-7px; top:4px; width:8px; height:9px; border:1.5px solid #6b4226; border-left:none; border-radius:0 6px 6px 0;\"><\u002Fdiv>\n            <div style=\"position:absolute; bottom:0; left:0; width:26px; height:16px; border:1.5px solid #6b4226; border-top:none; border-radius:0 0 8px 8px; background:#fff;\"><\u002Fdiv>\n          <\u002Fdiv>\n          <p style=\"font-size:16px; line-height:1.6; color:#4a3527; margin:0;\">When I'm not at my desk, I'm probably making another cup of coffee, or sidequesting with my girlfriend and friends (interpersonal skills example lol) — usually both are happening at once.<\u002Fp>\n        <\u002Fdiv>\n\n        <h2 style=\"font-family:'Lora',serif; font-size:24px; margin:44px 0 18px;\">Education<\u002Fh2>\n        <div style=\"border-left:2px solid #e8d9c8; padding-left:20px; margin-bottom:8px;\">\n          <div style=\"font-weight:700; font-size:16px;\">B.Tech, Computer Science (AI &amp; ML) — VIT<\u002Fdiv>\n          <div style=\"color:#6b5645; font-size:14px; margin-top:2px;\">Aug 2023 – Jul 2027 · CGPA 9.27<\u002Fdiv>\n        <\u002Fdiv>\n\n        <h2 style=\"font-family:'Lora',serif; font-size:24px; margin:44px 0 18px;\">Experience<\u002Fh2>\n        <div style=\"border-left:2px solid #e8d9c8; padding-left:20px;\">\n          <div style=\"font-weight:700; font-size:16px;\">AI/ML Intern — WE Excel Software Pvt. Ltd.<\u002Fdiv>\n          <div style=\"color:#6b5645; font-size:14px; margin:2px 0 10px;\">June 2025 · On-site<\u002Fdiv>\n          <ul style=\"margin:0; padding-left:18px; color:#4a3527; font-size:15px; line-height:1.7;\">\n            <li>Built an OCR pipeline extracting data from Aadhaar &amp; PAN cards for an internal HRMS.<\u002Fli>\n            <li>Tuned retrieval settings for a RAG-based HR chatbot.<\u002Fli>\n            <li>Explored web scraping, automation and API integration.<\u002Fli>\n          <\u002Ful>\n        <\u002Fdiv>\n\n        <h2 style=\"font-family:'Lora',serif; font-size:24px; margin:44px 0 18px;\">Skills<\u002Fh2>\n        <div style=\"display:grid; grid-template-columns:repeat(2,1fr); gap:18px;\">\n          <sc-for list=\"{{ skillGroups }}\" as=\"grp\" hint-placeholder-count=\"4\">\n            <div>\n              <div style=\"font-weight:700; font-size:14px; color:#8c5a2b; margin-bottom:6px;\">{{ grp.title }}<\u002Fdiv>\n              <div style=\"font-size:14px; color:#4a3527; line-height:1.6;\">{{ grp.items }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n\n        <h2 style=\"font-family:'Lora',serif; font-size:24px; margin:44px 0 18px;\">Certifications<\u002Fh2>\n        <p style=\"font-size:15px; color:#4a3527; line-height:1.7; margin:0;\">AI Foundations Associate (Oracle) · Intro to Model Context Protocol (Anthropic) · Generative AI (LinkedIn)<\u002Fp>\n\n        <div style=\"margin-top:36px; background:#f3e6d4; border-radius:16px; padding:22px 26px;\">\n          <div style=\"font-weight:700; font-size:14px; color:#8c5a2b; margin-bottom:6px;\">Published<\u002Fdiv>\n          <div style=\"font-size:15px; color:#4a3527; line-height:1.6;\">\"Nonlinear Balance Sheet Fragility and the Prediction of Short-Horizon Liquidity Stress\" — under review, Computational Economics (Springer). First author.<\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsection>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isWork }}\" hint-placeholder-val=\"{{ false }}\">\n      <section style=\"max-width:1080px; margin:0 auto; padding:80px 48px;\">\n        <div style=\"font-size:12.5px; font-weight:700; letter-spacing:0.08em; color:#b5502f; text-transform:uppercase; margin-bottom:10px;\">Selected work<\u002Fdiv>\n        <h1 style=\"font-family:'Lora',serif; font-size:40px; margin:0 0 12px;\">Things I've <span style=\"color:#b5502f;\">built<\u002Fspan><\u002Fh1>\n        <p style=\"font-size:17px; color:#6b5645; margin:0 0 44px;\">Mostly agentic AI and RAG systems — with the occasional detour into 3D cities and OCR.<\u002Fp>\n        <div style=\"display:flex; flex-direction:column; gap:20px;\">\n          <sc-for list=\"{{ projects }}\" as=\"proj\" hint-placeholder-count=\"0\">\n            <div style=\"display:flex; gap:0; background:#fff; border:1px solid #eee0cf; border-radius:18px; overflow:hidden; cursor:pointer;\" style-hover=\"border-color:#e0a97a; box-shadow:0 16px 32px -22px rgba(59,36,26,0.3);\" sc-camel-on-click=\"{{ proj.onCardClick }}\">\n              <div style=\"width:220px; flex-shrink:0; background:#f3e6d4; position:relative; overflow:hidden;\">\n                <sc-if value=\"{{ proj.hasDemo }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"{{ proj.thumbStyle }}\"><\u002Fdiv>\n                <\u002Fsc-if>\n<sc-if value=\"{{ proj.noDemo }}\" hint-placeholder-val=\"{{ false }}\">\n                  <image-slot id=\"{{ proj.slotId }}\" shape=\"rect\" placeholder=\"drop a screenshot\" style=\"width:100%; height:100%;\"><\u002Fimage-slot>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n              <div style=\"flex:1; padding:26px 28px; min-width:0;\">\n                <div style=\"display:flex; justify-content:space-between; align-items:flex-start; gap:20px; flex-wrap:wrap;\">\n                  <div style=\"font-family:'Lora',serif; font-weight:700; font-size:21px;\">{{ proj.name }}<\u002Fdiv>\n                  <div style=\"font-size:13px; color:#b5502f; font-weight:700; white-space:nowrap;\">View details →<\u002Fdiv>\n                <\u002Fdiv>\n                <p style=\"font-size:15px; color:#4a3527; line-height:1.65; margin:12px 0 16px;\">{{ proj.short }}<\u002Fp>\n                <div style=\"display:flex; gap:8px; flex-wrap:wrap;\">\n                  <sc-for list=\"{{ proj.tags }}\" as=\"tag\" hint-placeholder-count=\"3\">\n                    <span style=\"background:#f3e2ce; color:#8c5a2b; font-size:12px; font-weight:600; padding:5px 12px; border-radius:999px;\">{{ tag }}<\u002Fspan>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fsection>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isProject }}\" hint-placeholder-val=\"{{ false }}\">\n      <section style=\"max-width:820px; margin:0 auto; padding:60px 48px 80px;\">\n        <span sc-camel-on-click=\"{{ goWork }}\" style=\"cursor:pointer; font-weight:700; font-size:14px; color:#b5502f;\">← Back to work<\u002Fspan>\n        <h1 style=\"font-family:'Lora',serif; font-size:36px; margin:20px 0 12px;\">{{ activeProject.name }}<\u002Fh1>\n        <div style=\"display:flex; gap:8px; flex-wrap:wrap; margin-bottom:24px;\">\n          <sc-for list=\"{{ activeProject.tagChips }}\" as=\"tag\" hint-placeholder-count=\"3\">\n            <span style=\"background:#f3e2ce; color:#8c5a2b; font-size:12px; font-weight:600; padding:5px 12px; border-radius:999px;\">{{ tag }}<\u002Fspan>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n        <sc-if value=\"{{ activeProject.hasGallery }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"width:100%; aspect-ratio:16/10; border-radius:16px; overflow:hidden; border:1px solid #eee0cf; margin-bottom:14px;\">\n            <div style=\"{{ activeProject.galleryImgStyle }}\"><\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"display:flex; gap:6px; justify-content:center; margin-bottom:28px;\">\n            <sc-for list=\"{{ activeProject.dots }}\" as=\"dot\" hint-placeholder-count=\"3\">\n              <div style=\"{{ dot.style }}\" sc-camel-on-click=\"{{ dot.onClick }}\"><\u002Fdiv>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n        <p style=\"font-size:17px; line-height:1.7; color:#4a3527; margin:0 0 32px;\">{{ activeProject.long }}<\u002Fp>\n        <a href=\"{{ activeProject.url }}\" target=\"_blank\" style=\"display:inline-flex; align-items:center; gap:8px; background:#b5502f; color:#fff; padding:13px 24px; border-radius:10px; font-weight:700; font-size:15px;\" style-hover=\"background:#8c3b21;\">View source on GitHub ↗<\u002Fa>\n      <\u002Fsection>\n    <\u002Fsc-if>\n\n    <sc-if value=\"{{ isContact }}\" hint-placeholder-val=\"{{ false }}\">\n      <section style=\"max-width:640px; margin:0 auto; padding:80px 48px;\">\n        <div style=\"font-size:12.5px; font-weight:700; letter-spacing:0.08em; color:#b5502f; text-transform:uppercase; margin-bottom:10px;\">Get in touch<\u002Fdiv>\n        <h1 style=\"font-family:'Lora',serif; font-size:40px; margin:0 0 12px;\">Let's <span style=\"color:#b5502f;\">talk<\u002Fspan><\u002Fh1>\n        <p style=\"font-size:17px; color:#6b5645; margin:0 0 40px;\">Drop me a line — I read everything, and I reply faster than I probably should.<\u002Fp>\n\n        <div style=\"display:flex; flex-direction:column; gap:16px; margin-bottom:44px;\">\n          <input placeholder=\"Your name\" value=\"{{ form.name }}\" sc-camel-on-change=\"{{ setName }}\" style=\"padding:14px 16px; border-radius:10px; border:1.5px solid #e8d9c8; font-family:'Karla',sans-serif; font-size:15px; background:#fff;\">\n          <input placeholder=\"Your email\" value=\"{{ form.email }}\" sc-camel-on-change=\"{{ setEmail }}\" style=\"padding:14px 16px; border-radius:10px; border:1.5px solid #e8d9c8; font-family:'Karla',sans-serif; font-size:15px; background:#fff;\">\n          <textarea placeholder=\"What's up?\" value=\"{{ form.message }}\" sc-camel-on-change=\"{{ setMessage }}\" rows=\"5\" style=\"padding:14px 16px; border-radius:10px; border:1.5px solid #e8d9c8; font-family:'Karla',sans-serif; font-size:15px; background:#fff; resize:vertical;\"><\u002Ftextarea>\n          <button sc-camel-on-click=\"{{ sendMail }}\" style=\"background:#b5502f; color:#fff; border:none; padding:15px 26px; border-radius:10px; font-weight:700; font-size:15px; cursor:pointer; align-self:flex-start;\" style-hover=\"background:#8c3b21;\">Send it over<\u002Fbutton>\n        <\u002Fdiv>\n\n        <div style=\"display:flex; gap:22px; padding-top:28px; border-top:1px solid #eee0cf;\">\n          <a href=\"mailto:aryankochhar2005@gmail.com\" style=\"font-weight:700; font-size:14px;\">Email<\u002Fa>\n          <a href=\"https://github.com/Aryan-Kochhar\" target=\"_blank\" style=\"font-weight:700; font-size:14px;\">GitHub<\u002Fa>\n          <a href=\"https://linkedin.com/in/aryan-kochhar\" target=\"_blank\" style=\"font-weight:700; font-size:14px;\">LinkedIn<\u002Fa>\n          <a href=\"https://x.com/AryanKochhar2\" target=\"_blank\" style=\"font-weight:700; font-size:14px;\">X<\u002Fa>\n          <a href=\"https://instagram.com/_aryankochhar\" target=\"_blank\" style=\"font-weight:700; font-size:14px;\">Instagram<\u002Fa>\n        <\u002Fdiv>\n      <\u002Fsection>\n    <\u002Fsc-if>\n\n  <\u002Fmain>\n\n  <footer style=\"border-top:1px solid #e8d9c8; padding:28px 48px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;\">\n    <div style=\"font-size:13px; color:#8a7360;\">© 2026 Aryan Kochhar<\u002Fdiv>\n    <div style=\"font-family:'Lora',serif; font-size:15px; font-weight:600; color:#b5502f;\">{{ footerSignature }}<\u002Fdiv>\n  <\u002Ffooter>\n\n\n\n<\u002Fdiv>\n\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;: {}, &quot;accentColor&quot;: {&quot;editor&quot;: &quot;color&quot;, &quot;default&quot;: &quot;#b5502f&quot;, &quot;tsType&quot;: &quot;string&quot;, &quot;options&quot;: [&quot;#b5502f&quot;, &quot;#a8763f&quot;, &quot;#c96f4a&quot;, &quot;#8c5a2b&quot;]}, &quot;footerSignature&quot;: {&quot;editor&quot;: &quot;text&quot;, &quot;default&quot;: &quot;Arry 💜 Rads&quot;, &quot;tsType&quot;: &quot;string&quot;}}\">\nclass Component extends DCLogic {\n  state = {\n    page: 'home',\n    form: { name: '', email: '', message: '' },\n    hoverHome: null,\n    hoverWork: null,\n    loading: true,\n    fading: false,\n    popping: false,\n    coffeeClicks: 0,\n    showQuote: false,\n    quoteText: '',\n\n    projectId: null,\n    galleryIndex: 0,\n    logmindThumbIdx: 0\n  };\n\n  componentDidMount() {\n    setTimeout(() => this.setState({ fading: true }), 1400);\n    setTimeout(() => this.setState({ loading: false }), 1900);\n    this._galleryTimer = setInterval(() => this.advanceGallery(), 4500);\n    this._logmindTimer = setInterval(() => this.setState(s => ({ logmindThumbIdx: s.logmindThumbIdx + 1 })), 4000);\n  }\n\n  advanceGallery() {\n    if (this.state.page !== 'project') return;\n    const proj = this.getProjects().find(p => p.id === this.state.projectId);\n    if (!proj || proj.gallery.length < 2) return;\n    this.setState(s => ({ galleryIndex: (s.galleryIndex + 1) % proj.gallery.length }));\n  }\n\n  componentWillUnmount() {\n    clearInterval(this._galleryTimer);\n    clearInterval(this._logmindTimer);\n    clearTimeout(this._quoteTimer);\n    clearTimeout(this._popTimer);\n  }\n\n  goProject(id) {\n    this.setState({ page: 'project', projectId: id, galleryIndex: 0 });\n    window.scrollTo(0, 0);\n  }\n\n  getProjects() {\n    return [\n      { id: 'quant-copilot', name: 'Quant Copilot', url: 'https://github.com/Aryan-Kochhar/Agentic-Quantitative-Research-Copilot',\n        short: 'An agent that answers natural-language finance queries by chaining 8 custom tools over MCP — market data, backtesting, VaR, correlation, drawdown. Streams reasoning live over WebSocket, with a Redis + MongoDB Atlas two-tier cache and a Groq-to-local-Ollama fallback.',\n        long: \"Ask it something like \\\"what's the max drawdown of MSFT this year\\\" and it plans its own tool calls — pulling live prices, running the quant analysis, and streaming each step (tool_call → tool_done → answer) to the frontend over WebSocket. Backed by a two-tier cache (Redis for hot queries, MongoDB Atlas for price history) and a Groq-to-local-Ollama fallback so it stays available even under rate limits.\",\n        tags: ['Python', 'MCP', 'RAG', 'Finance'],\n        gallery: ['https://github.com/Aryan-Kochhar/Agentic-Quantitative-Research-Copilot/raw/main/assets/00-landing-hero.png', 'https://github.com/Aryan-Kochhar/Agentic-Quantitative-Research-Copilot/raw/main/assets/01-landing.gif', 'https://github.com/Aryan-Kochhar/Agentic-Quantitative-Research-Copilot/raw/main/assets/02-agent-run.gif', 'https://github.com/Aryan-Kochhar/Agentic-Quantitative-Research-Copilot/raw/main/assets/03-tool-stream.gif'] },\n      { id: 'logmind', name: 'LogMind', url: 'https://github.com/Aryan-Kochhar/LogMind---Server-Log-Analyzer',\n        short: 'A RAG-powered log analyzer — ask natural-language questions about server logs instead of grepping through them. Semantic vector search and anomaly detection via MongoDB Atlas, with a Streamlit dashboard and CLI.',\n        long: 'Point it at a log file and just talk to it — \"what happened on the 17th\" or \"are there any security threats\" — and it answers using RAG over your own logs, no cloud LLM required (runs on local Ollama). It auto-flags error spikes and known-bad keywords like timeout and deadlock, and ships with both a CLI and a Streamlit dashboard for browsing, filtering, and exporting.',\n        tags: ['Python', 'RAG', 'MongoDB'],\n        gallery: ['https://github.com/Aryan-Kochhar/LogMind---Server-Log-Analyzer/raw/main/assets/demo.png', 'https://github.com/Aryan-Kochhar/LogMind---Server-Log-Analyzer/raw/main/assets/Streamlit1.png', 'https://github.com/Aryan-Kochhar/LogMind---Server-Log-Analyzer/raw/main/assets/Streamlit2.png', 'https://github.com/Aryan-Kochhar/LogMind---Server-Log-Analyzer/raw/main/assets/Streamlit3.png'] },\n      { id: 'architech', name: 'ArchiTech', url: 'https://github.com/Aryan-Kochhar/-ArchiTech-',\n        short: 'Turns a text prompt into a structured 3D city layout. A multi-stage LLM pipeline with a self-correcting validator loop and embedding-based retrieval of layout templates for tricky spatial phrasing.',\n        long: 'Feed it a prompt like \"two rows of buildings split by a river\" and a local planner LLM sketches the zones, a Groq-hosted model places exact grid coordinates, and a deterministic (no-LLM) validator checks the result for overlaps, adjacency, and symmetry — kicking it back for another pass if it fails. A RAG variant retrieves the closest hand-built layout template first, which held up far better on tricky spatial language like \"surrounding\" or \"on both sides.\"',\n        tags: ['Python', 'LLM Pipeline', '3D'],\n        gallery: ['https://github.com/Aryan-Kochhar/-ArchiTech-/raw/main/demo/demo.gif', 'https://github.com/Aryan-Kochhar/-ArchiTech-/raw/main/demo/demo2.gif'] },\n      { id: 'aadhaar-ocr', name: 'Aadhaar Card OCR API', url: 'https://github.com/Aryan-Kochhar/Aadhar-Card-OCR-API',\n        short: 'A lightweight Flask REST API that extracts name, DOB, gender, ID number, address and guardian info from Aadhaar card images using Tesseract OCR.',\n        long: 'Send it front and back images of an Indian Aadhaar card and it hands back structured JSON — name, DOB, gender, Aadhaar number, address, pincode, guardian info — pulled out with Tesseract OCR. Ships as a Flask API, a Flask-RESTful variant, and a bare local-file version, all sharing the same OCR core.',\n        tags: ['Flask', 'OCR', 'REST API'], gallery: ['uploads/pasted-1785218039822-0.png'] },\n      { id: 'congestion-rl', name: 'Congestion Control with RL', url: 'https://github.com/Aryan-Kochhar/Congestion-Control-With-RL',\n        short: 'A SUMO traffic simulation combining reinforcement learning with real-time detection to optimize traffic flow under changing conditions.',\n        long: 'A SUMO-based intersection simulation where a Q-learning agent watches queue lengths, wait times, and vehicle density, then adjusts signal timing to keep traffic moving — while automatically clearing a path and giving right-of-way the moment it detects an emergency vehicle.',\n        tags: ['Python', 'Reinforcement Learning', 'SUMO'], gallery: ['https://github.com/Aryan-Kochhar/Congestion-Control-With-RL/raw/main/congestion-control.gif'] },\n      { id: 'resonance', name: 'Resonance', url: 'https://github.com/Aryan-Kochhar/Resonance',\n        short: 'Exploring data-driven denoising of wireless communication channels to improve the reliability and efficiency of modern wireless systems like 5G and IoT.',\n        long: 'A group-project contribution exploring learned, data-driven denoising for wireless channels — aiming to squeeze more reliability and efficiency out of 5G/IoT-style links than classical signal-processing approaches manage on their own.',\n        tags: ['Python', 'Signal Processing', '5G/IoT'], gallery: ['https://github.com/Aryan-Kochhar/Resonance/raw/final/visualizations/summary_poster.png'] }\n    ];\n  }\n\n  go(page) { this.setState({ page }); window.scrollTo(0, 0); }\n\n  popCoffee() {\n    const quotes = [\n      \"ngl I needed that\",\n      \"okay that hit the spot\",\n      \"brb, refilling my cup\",\n      \"yeah I'm definitely over-caffeinated\",\n      \"coffee o'clock, always\",\n      \"this is basically self-care at this point\",\n      \"third one today, no shame\",\n      \"keep clicking, I'm not judging\",\n      \"my code runs better with more of these\",\n      \"bas ek aur cup\",\n      \"chalta hai, one more won't hurt\",\n      \"atp just drink monster dude 🙏🙏\"\n    ];\n    clearTimeout(this._quoteTimer);\n    clearTimeout(this._popTimer);\n    const clicks = this.state.coffeeClicks + 1;\n    const text = clicks % 10 === 0 ? \"bas bas, itna kaafi hai 😅\" : quotes[Math.floor(Math.random() * quotes.length)];\n    this.setState({ popping: true, showQuote: true, quoteText: text, coffeeClicks: clicks });\n    this._popTimer = setTimeout(() => this.setState({ popping: false }), 700);\n    this._quoteTimer = setTimeout(() => this.setState({ showQuote: false }), 2000);\n  }\n\n  renderVals() {\n    const accent = this.props.accentColor || '#b5502f';\n    const page = this.state.page;\n    const navStyle = (active) => `cursor:pointer; padding:9px 16px; border-radius:8px; font-weight:600; font-size:14.5px; color:${active ? '#fff' : '#3b241a'}; background:${active ? accent : 'transparent'};`;\n\n    const rawProjects = this.getProjects();\n    const projects = rawProjects.map((p, i) => {\n      const demo = p.gallery[0] || null;\n      return {\n        ...p,\n        onCardClick: () => this.goProject(p.id),\n        hasDemo: !!demo,\n        noDemo: !demo,\n        slotId: `work-thumb-${p.id}`,\n        thumbStyle: `width:100%; height:100%; background-image:url(${demo || ''}); background-size:cover; background-position:center;`\n      };\n    });\n    const activeRaw = rawProjects.find(p => p.id === this.state.projectId) || rawProjects[0];\n    const galleryIdx = this.state.galleryIndex % Math.max(activeRaw.gallery.length, 1);\n    const activeProject = {\n      ...activeRaw,\n      hasGallery: activeRaw.gallery.length > 0,\n      galleryImgStyle: `width:100%; height:100%; background-image:url(${activeRaw.gallery[galleryIdx] || ''}); background-size:cover; background-position:center;`,\n      dots: activeRaw.gallery.map((g, i) => ({\n        style: `width:${i === galleryIdx ? 9 : 7}px; height:${i === galleryIdx ? 9 : 7}px; border-radius:50%; background:${i === galleryIdx ? '#b5502f' : '#e0cbb0'}; cursor:pointer; transition:all 0.2s;`,\n        onClick: () => { clearInterval(this._galleryTimer); this.setState({ galleryIndex: i }); this._galleryTimer = setInterval(() => this.advanceGallery(), 4500); }\n      })),\n      tagChips: activeRaw.tags\n    };\n\n    return {\n      isHome: page === 'home', isAbout: page === 'about', isWork: page === 'work', isContact: page === 'contact', isProject: page === 'project',\n      goHome: () => this.go('home'), goWork: () => this.go('work'), goContact: () => this.go('contact'),\n      activeProject,\n      navItems: [\n        { label: 'Home', go: () => this.go('home'), style: navStyle(page === 'home') },\n        { label: 'About', go: () => this.go('about'), style: navStyle(page === 'about') },\n        { label: 'Work', go: () => this.go('work'), style: navStyle(page === 'work') },\n        { label: 'Contact', go: () => this.go('contact'), style: navStyle(page === 'contact') }\n      ],\n      focusAreas: [\n        { title: 'Agentic Systems', blurb: 'Agents that chain tools, not just answer questions.', mark: '01' },\n        { title: 'RAG & Retrieval', blurb: 'Grounding LLMs in real data, reliably.', mark: '02' },\n        { title: 'Quant Research', blurb: 'Where finance meets machine learning.', mark: '03' }\n      ],\n      featuredProjects: rawProjects.slice(0, 3).map((p, i) => {\n        const demo = (p.id === 'quant-copilot' ? p.gallery[1] : p.id === 'logmind' ? p.gallery[this.state.logmindThumbIdx % p.gallery.length] : p.gallery[0]) || null;\n        return {\n          name: p.name, short: p.short, url: p.url,\n          onCardClick: () => this.goProject(p.id),\n          hasDemo: !!demo,\n          noDemo: !demo,\n          slotId: `home-thumb-${p.id}`,\n          thumbStyle: `width:100%; height:100%; background-image:url(${demo || ''}); background-size:cover; background-position:center;`\n        };\n      }),\n      projects,\n      skillGroups: [\n        { title: 'Languages', items: 'Python, C, C++, Java, SQL' },\n        { title: 'AI / ML', items: 'NumPy, Pandas, OpenCV, scikit-learn, LangChain, RAG' },\n        { title: 'Web', items: 'HTML, CSS, JavaScript' },\n        { title: 'Tools', items: 'FastAPI, REST APIs, MongoDB Atlas, Redis, MCP, Ollama, Git' }\n      ],\n      form: this.state.form,\n      setName: (e) => this.setState(s => ({ form: { ...s.form, name: e.target.value } })),\n      setEmail: (e) => this.setState(s => ({ form: { ...s.form, email: e.target.value } })),\n      setMessage: (e) => this.setState(s => ({ form: { ...s.form, message: e.target.value } })),\n      sendMail: () => {\n        const { name, email, message } = this.state.form;\n        const body = encodeURIComponent(`${message}\\n\\n— ${name} (${email})`);\n        window.location.href = `mailto:aryankochhar2005@gmail.com?subject=Hey Arry&body=${body}`;\n      },\n      footerSignature: this.props.footerSignature || 'Arry 💜 Rads',\n      loaderStyle: `position:fixed; inset:0; z-index:9999; background:#fbf3ea; display:${this.state.loading ? 'flex' : 'none'}; align-items:center; justify-content:center; flex-direction:column; opacity:${this.state.fading ? 0 : 1}; transition:opacity 0.5s ease;`,\n      popCoffee: () => this.popCoffee(),\n      coffeeButtonNode: React.createElement('div', {\n        onClick: () => this.popCoffee(),\n        style: { position: 'relative', width: '40px', height: '40px', borderRadius: '50%', background: '#b5502f', display: 'flex', alignItems: 'center', justifyContent: 'center', cursor: 'pointer', boxShadow: '0 6px 16px -6px rgba(181,80,47,0.6)', transform: this.state.popping ? 'scale(1.15)' : 'scale(1)', transition: 'transform 0.25s ease' }\n      },\n        React.createElement('div', { style: { position: 'absolute', bottom: '36px', left: '12px', width: '3px', height: '6px', border: '1.5px solid #b5502f', borderBottom: 'none', borderRadius: '3px 3px 0 0', opacity: 0.6, animation: 'steamRise 1.8s ease-in-out infinite' } }),\n        React.createElement('div', { style: { position: 'absolute', bottom: '36px', left: '19px', width: '3px', height: '7px', border: '1.5px solid #b5502f', borderBottom: 'none', borderRadius: '3px 3px 0 0', opacity: 0.6, animation: 'steamRise 1.8s ease-in-out infinite 0.6s' } }),\n        React.createElement('div', { style: { position: 'relative', width: '16px', height: '13px' } },\n          React.createElement('div', { style: { position: 'absolute', bottom: 0, left: 0, width: '16px', height: '11px', background: '#fff', borderRadius: '0 0 5px 5px' } }),\n          React.createElement('div', { style: { position: 'absolute', right: '-6px', top: '1px', width: '6px', height: '6px', border: '1.5px solid #fff', borderLeft: 'none', borderRadius: '0 4px 4px 0' } })\n        )\n      ),\n      quoteBubbleNode: React.createElement('div', {\n        style: { position: 'fixed', top: '66px', right: '48px', zIndex: 60, background: '#3b241a', color: '#fbf3ea', fontFamily: \"'Karla',sans-serif\", fontWeight: 600, fontSize: '13.5px', padding: '9px 14px', borderRadius: '10px', boxShadow: '0 10px 24px -10px rgba(59,36,26,0.5)', opacity: this.state.showQuote ? 1 : 0, transform: this.state.showQuote ? 'translateY(0)' : 'translateY(-6px)', transition: 'opacity 0.25s ease, transform 0.25s ease', pointerEvents: 'none', whiteSpace: 'nowrap' }\n      }, this.state.quoteText),\n      beanNodes: [0, 1, 2, 3, 4, 5].map((i) => {\n        const angle = (i / 6) * Math.PI * 2 - Math.PI / 2;\n        const dx = Math.cos(angle) * 44;\n        const dy = Math.sin(angle) * 44;\n        const active = this.state.popping;\n        return React.createElement('div', {\n          key: i,\n          style: { position: 'fixed', top: `calc(38px + ${active ? dy : 0}px)`, right: `calc(60px - ${active ? dx : 0}px)`, width: '8px', height: '8px', borderRadius: '50%', background: i % 2 ? '#6b4226' : '#b5502f', opacity: active ? 1 : 0, transition: 'all 0.6s cubic-bezier(0.2,0.8,0.3,1), opacity 0.5s ease', pointerEvents: 'none', zIndex: 60 }\n        });\n      }),\n\n    };\n  }\n}\n\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
